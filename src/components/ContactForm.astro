---
import rules from "../../api/rules.json";

type Country = { nombre: string; dial: string };

// Fuente única de reglas y países: api/rules.json (la misma que usa el PHP).
const countries: Country[] = rules.paises;
const territories: Country[] = rules.territorios;

// Estilos equivalentes a los del formulario de index.astro (site.css) expresados con Tailwind.
const controlClass =
    "mt-2 min-h-12 w-full rounded-none border border-[#7b8da6] bg-white px-3.5 py-3 text-base font-normal placeholder:text-[#606f84] placeholder:opacity-100 focus-visible:[outline:2px_solid_#164398] focus-visible:[outline-offset:3px]";
const arrowClass =
    "h-6 w-6 shrink-0 transition-transform duration-[250ms] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0";
const errorClass = "field-error";
---

<style>
    /* Honeypot: fuera de la vista, pero presente para los bots. */
    .hp {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }

    .field-error {
        margin-top: 6px;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.45;
        color: #a4231a;
    }

    /* site.css (sin capas) fuerza width:100% y min-height en todos los input. */
    .consent-row .consent-box {
        width: 1.25rem;
        height: 1.25rem;
        min-height: 0;
        margin: 2px 0 0;
        padding: 0;
        flex: 0 0 auto;
        accent-color: #164398;
    }

    .consent-row .consent-label {
        display: block;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.5;
        margin: 0;
    }

    input[aria-invalid="true"],
    select[aria-invalid="true"],
    textarea[aria-invalid="true"] {
        border-color: #a4231a;
    }

    #form-status[data-state="ok"] {
        color: #0c5132;
        background: #eef8f1;
    }

    #form-status[data-state="error"] {
        color: #8a1c14;
        background: #fdf1ef;
    }

    /* Lightbox de resultado: verde si se envió, rojo si falló. */
    .lightbox {
        width: min(26rem, calc(100vw - 2rem));
        max-width: none;
        margin: auto;
        padding: 0;
        border: 0;
        background: transparent;
        color: #fff;
        overflow: visible;
    }

    .lightbox::backdrop {
        background: rgba(8, 18, 33, 0.62);
    }

    .lightbox[open] {
        animation: lightbox-in 180ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .lightbox-card {
        position: relative;
        overflow: hidden;
        padding: 26px 24px 22px;
        box-shadow: 0 26px 70px rgba(6, 16, 30, 0.32);
    }

    .lightbox[data-state="ok"] .lightbox-card {
        background: #0c5132;
    }

    .lightbox[data-state="error"] .lightbox-card {
        background: #8a1c14;
    }

    .lightbox-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.16);
        color: #fff;
    }

    .lightbox[data-state="ok"] .lightbox-icon-error,
    .lightbox[data-state="error"] .lightbox-icon-ok {
        display: none;
    }

    .lightbox-title {
        margin: 14px 0 0;
        font-size: 20px;
        font-weight: 600;
        line-height: 1.25;
        letter-spacing: -0.01em;
    }

    .lightbox-message {
        margin: 8px 0 0;
        font-size: 15px;
        line-height: 1.55;
        color: rgba(255, 255, 255, 0.94);
    }

    .lightbox-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 44px;
        margin-top: 18px;
        padding: 8px 16px;
        border: 1px solid rgba(255, 255, 255, 0.6);
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        font-size: 15px;
        font-weight: 550;
        line-height: 1.4;
        cursor: pointer;
        transition: background-color 160ms ease;
    }

    .lightbox-close:hover {
        background: rgba(255, 255, 255, 0.18);
    }

    .lightbox-close:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 3px;
    }

    .lightbox-progress {
        position: absolute;
        inset: auto 0 0;
        height: 3px;
        background: rgba(255, 255, 255, 0.85);
        transform-origin: left center;
        animation: lightbox-progress 3000ms linear forwards;
    }

    @keyframes lightbox-in {
        from {
            opacity: 0;
            transform: translateY(10px) scale(0.98);
        }
    }

    @keyframes lightbox-progress {
        from {
            transform: scaleX(1);
        }
        to {
            transform: scaleX(0);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .lightbox[open] {
            animation: none;
        }

        .lightbox-progress {
            animation: none;
        }
    }
</style>

<form
    id="contact-form"
    action="/api/contact.php"
    method="post"
    tabindex="-1"
    class="scroll-mt-6 bg-white p-9 text-[#101c36] max-[1100px]:p-7 max-[960px]:p-6 max-[380px]:p-5"
    aria-labelledby="contact-form-title"
    aria-describedby="form-requirements"
>
    <h3
        id="contact-form-title"
        class="text-[29px] font-[550] leading-[1.14] tracking-[-0.028em] text-balance max-[960px]:text-[26px]"
    >
        Hablemos de tu granja
    </h3>
    <p class="mt-3.5 max-w-[70ch] text-[17px] text-[#48586e] max-[640px]:text-base">
        Completa los datos y te responderemos con la información que necesitas.
    </p>
    <p
        id="inquiry-context"
        class="my-4.5 bg-[#f3f6fa] p-3.5 text-[15px] text-[#164398]"
        aria-live="polite"
        hidden
    ></p>
    <p id="form-requirements" class="mt-4.5 max-w-[70ch] text-[14px] text-[#48586e]">
        Todos los campos son obligatorios, excepto Empresa.
    </p>
    <p id="form-summary" class={`${errorClass} my-4.5`} role="alert" hidden></p>

    <div class="my-6 grid grid-cols-2 gap-5 max-[1100px]:grid-cols-1 max-[640px]:gap-4.5">
        <div class="field">
            <label class="block text-base font-medium" for="nombre">Nombre</label>
            <input
                id="nombre"
                class={controlClass}
                name="nombre"
                autocomplete="name"
                required
                maxlength="100"
                placeholder="Tu nombre"
                aria-describedby="error-nombre"
            />
            <p id="error-nombre" class={errorClass} data-error-for="nombre" role="alert" hidden></p>
        </div>
        <div class="field">
            <label class="block text-base font-medium" for="empresa">
                Empresa <span class="text-sm font-normal">(opcional)</span>
            </label>
            <input
                id="empresa"
                class={controlClass}
                name="empresa"
                autocomplete="organization"
                maxlength="150"
                placeholder="Nombre de tu empresa"
                aria-describedby="error-empresa"
            />
            <p id="error-empresa" class={errorClass} data-error-for="empresa" role="alert" hidden></p>
        </div>
        <div class="field col-span-full">
            <label class="block text-base font-medium" for="email">Correo electrónico</label>
            <input
                id="email"
                class={controlClass}
                type="email"
                name="email"
                autocomplete="email"
                inputmode="email"
                required
                maxlength="254"
                placeholder="tu@correo.com"
                aria-describedby="error-email"
            />
            <p id="error-email" class={errorClass} data-error-for="email" role="alert" hidden></p>
        </div>
        <div
            class="col-span-full grid grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] items-end gap-4 max-[640px]:grid-cols-1 max-[640px]:gap-4.5"
        >
            <div class="field min-w-0">
                <label class="block text-base font-medium" for="pais">País o territorio</label>
                <select
                    class={`${controlClass} pr-7.5`}
                    name="pais"
                    id="pais"
                    required
                    aria-describedby="error-pais"
                >
                    <option value="">Selecciona una opción</option>
                    <optgroup label="Países de Latinoamérica y el Caribe">
                        {countries.map((country) => (
                            <option value={country.dial} data-country={country.nombre}>
                                {country.nombre} ({country.dial})
                            </option>
                        ))}
                    </optgroup>
                    <optgroup label="Territorios de Latinoamérica y el Caribe">
                        {territories.map((territory) => (
                            <option value={territory.dial} data-country={territory.nombre}>
                                {territory.nombre} ({territory.dial})
                            </option>
                        ))}
                    </optgroup>
                    <option value="otro" data-country="Otro país o territorio">Otro país o territorio</option>
                </select>
                <p id="error-pais" class={errorClass} data-error-for="pais" role="alert" hidden></p>
            </div>
            <div class="field min-w-0">
                <label class="block text-base font-medium" for="telefono">Teléfono</label>
                <input
                    id="telefono"
                    class={controlClass}
                    type="tel"
                    name="telefono"
                    autocomplete="tel"
                    inputmode="tel"
                    required
                    maxlength="32"
                    placeholder="Ej. 300 123 4567"
                    aria-describedby="error-telefono"
                />
                <p id="error-telefono" class={errorClass} data-error-for="telefono" role="alert" hidden></p>
            </div>
        </div>
        <div class="field col-span-full">
            <label class="block text-base font-medium" for="produccion">Tipo de producción</label>
            <select
                class={`${controlClass} pr-7.5`}
                name="produccion"
                id="produccion"
                required
                aria-describedby="error-produccion"
            >
                <option value="">Selecciona una opción</option>
                <option>Avicultura</option>
                <option>Porcicultura</option>
                <option>Avicultura y porcicultura</option>
            </select>
            <p id="error-produccion" class={errorClass} data-error-for="produccion" role="alert" hidden></p>
        </div>
    </div>

    <div class="field">
        <label class="block text-base font-medium" for="mensaje">¿Qué necesitas?</label>
        <textarea
            id="mensaje"
            class={`${controlClass} resize-y leading-[1.55]`}
            name="mensaje"
            rows="5"
            required
            maxlength="1800"
            aria-describedby="project-example error-mensaje"
            placeholder="Especie, etapa, ubicación y equipo que necesitas."></textarea>
        <p id="project-example" class="mt-3 max-w-[70ch] text-[14px] leading-[1.6] text-[#48586e]">
            Por ejemplo: granja de pollo de engorde, 30.000 aves, en Córdoba, Argentina. Busco líneas de
            alimentación para una nave de 120 x 14 m.
        </p>
        <p id="error-mensaje" class={errorClass} data-error-for="mensaje" role="alert" hidden></p>
    </div>

    <div class="consent-row mt-6 flex items-start gap-3">
        <input
            class="consent-box"
            type="checkbox"
            id="consent"
            name="consent"
            value="1"
            required
            aria-describedby="error-consent"
        />
        <div>
            <label class="consent-label" for="consent">
                Autorizo a AFGRANTEC SAS el tratamiento de mis datos para atender esta solicitud y su
                transferencia a proveedores tecnológicos en el exterior. He leído la
                <a
                    class="text-[#164398] underline decoration-1 underline-offset-4 hover:decoration-2"
                    href="/privacidad"
                    target="_blank"
                    rel="noopener">política de privacidad</a
                >.
            </label>
            <p id="error-consent" class={errorClass} data-error-for="consent" role="alert" hidden></p>
        </div>
    </div>

    <div class="hp" aria-hidden="true">
        <label for="website">No rellenar este campo</label>
        <input id="website" type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="t" id="form-rendered-at" value="" />
    <input type="hidden" name="pais_nombre" id="pais-nombre" value="" />
    <input type="hidden" name="origen" id="origen" value="" />

    <button
        class="group mt-6 inline-flex min-h-14 w-full items-center justify-center gap-3 whitespace-normal border border-[#164398] bg-[#164398] px-5.75 py-3 text-base font-[550] leading-[1.4] text-white transition-colors duration-180 hover:bg-[#0c306f] focus-visible:[outline:3px_solid_#be7800] focus-visible:outline-offset-[5px] disabled:cursor-wait motion-reduce:transition-none"
        type="submit"
        id="contact-submit"
    >
        <span class="text-white" id="submit-label">Enviar</span>
        <svg
            class={`${arrowClass} text-white`}
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
        >
            <path d="M4 12h15m-6-6 6 6-6 6"></path>
        </svg>
    </button>

    <p
        id="form-status"
        class="my-4.5 bg-[#f3f6fa] p-3.5 text-[15px] text-[#164398]"
        role="status"
        aria-live="polite"
        hidden
    ></p>
    <a
        id="email-fallback"
        class="group mt-4 inline-flex min-h-11 items-center gap-4 border-0 bg-transparent p-0 text-base font-medium leading-normal text-[#164398] underline decoration-1 underline-offset-[6px] hover:decoration-2 focus-visible:[outline:3px_solid_#be7800] focus-visible:outline-offset-[5px]"
        hidden
    >
        Escribirnos directamente por correo
        <svg
            class={arrowClass}
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
        >
            <path d="M4 12h15m-6-6 6 6-6 6"></path>
        </svg>
    </a>

    <dialog
        id="form-lightbox"
        class="lightbox"
        aria-labelledby="lightbox-title"
        aria-describedby="lightbox-message"
    >
        <div class="lightbox-card">
            <span class="lightbox-icon" aria-hidden="true">
                <svg
                    class="lightbox-icon-ok"
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m5 13 4 4L19 7"></path>
                </svg>
                <svg
                    class="lightbox-icon-error"
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="12" cy="12" r="9"></circle>
                    <path d="M12 8v5"></path>
                    <path d="M12 17h.01"></path>
                </svg>
            </span>
            <h4 id="lightbox-title" class="lightbox-title"></h4>
            <p id="lightbox-message" class="lightbox-message"></p>
            <button type="button" id="lightbox-close" class="lightbox-close">Cerrar</button>
            <span id="lightbox-progress" class="lightbox-progress" aria-hidden="true"></span>
        </div>
    </dialog>
</form>

<script>
    import "../scripts/contact-form";
</script>
