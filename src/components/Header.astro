---
import "../styles/site.css";
import "../styles/opening-a.css";

const path = Astro.url.pathname;
const isHome = path === "/" || path === "/inicio";
const anchor = (hash: string): string => (isHome ? hash : `/${hash}`);
---

<header class="site-header header-a" id="inicio">
  <a href={anchor("#inicio")} aria-label="AFGRANTEC, inicio">
    <img
      class="site-logo"
      src="/assets/logo-compact.svg"
      width="3210"
      height="600"
      alt="AFGRANTEC"
    />
  </a>
  <nav class="site-nav" aria-label="Navegación principal">
    <a href={anchor("#equipo")}>Equipo</a>
    <a href={anchor("#nosotros")}>Empresa</a>
    <a class="nav-contact" href={anchor("#contacto")}>
      Contacto
      <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 12h15m-6-6 6 6-6 6"></path>
      </svg>
    </a>
  </nav>
  <a class="mobile-contact" href={anchor("#contacto")}>
    Contacto
    <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 12h15m-6-6 6 6-6 6"></path>
    </svg>
  </a>
</header>
